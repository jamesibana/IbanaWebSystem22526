<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="MySite.master.cs" Inherits="IbanaWebSystem22526.MySite" %>
<!DOCTYPE html>
<html>
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%: Page.Title %> - James Carl Ibana Web Application</title>

    <asp:PlaceHolder runat="server">
        <%: Scripts.Render("~/bundles/modernizr") %>
    </asp:PlaceHolder>

    <webopt:BundleReference runat="server" Path="~/Content/css" />
    <link href="~/favicon.ico" rel="shortcut icon" type="image/x-icon" />

    <style>
        body {
            background-color: #e3efe8;
            background-image: radial-gradient(#c2d0c8 1px, transparent 1px);
            background-size: 20px 20px;
            background-attachment: fixed; 
        }

        .neo-navbar {
            background-color: #e3efe8 !important;
            box-shadow: 0px 10px 20px #c2d0c8, 0px -10px 20px #ffffff;
            border-bottom: 2px solid #ffffff; 
            padding: 1rem 0;
            margin-bottom: 2rem;
        }

        .neo-navbar .navbar-toggler {
            border: none;
        }
        
        .neo-navbar .navbar-toggler:focus {
            box-shadow: none;
            outline: none;
        }

        .neo-navbar .navbar-brand {
            color: #1a3324 !important; 
            font-weight: 800;
            letter-spacing: -0.5px;
            line-height: 1.1;
            text-align: center;
        }
        
        .neo-navbar .nav-link {
            color: #5c7465 !important; 
            font-weight: 600;
            transition: all 0.3s ease;
            border-radius: 10px;
            padding: 0.5rem 1rem !important;
            margin: 0 0.2rem;
            text-align: center; 
        }

        .neo-navbar .nav-link:hover {
            color: #238551 !important; 
            box-shadow: 4px 4px 8px #c2d0c8, -4px -4px 8px #ffffff; 
            background-color: #e3efe8;
            transform: translateY(-1px); 
        }

        .neo-navbar .active-nav-link,
        .neo-navbar .active-nav-link:hover { 
            color: #238551 !important; 
            box-shadow: inset 4px 4px 8px #c2d0c8, inset -4px -4px 8px #ffffff !important;
            background-color: #d1e0d7 !important; 
            font-weight: 800;
            transform: translateY(1px) !important; 
        }

        .neo-welcome-text {
            cursor: default; 
        }
        
        .neo-navbar .neo-welcome-text:hover {
            box-shadow: none !important;
            background-color: transparent !important;
            transform: none !important;
        }

        .neo-session-alert {
            display: none; 
            position: fixed; 
            top: 20px; 
            left: 50%; 
            transform: translateX(-50%); 
            background-color: #df5b5b;
            color: white; 
            padding: 1.5rem 2.5rem; 
            border-radius: 1.5rem; 
            z-index: 9999; 
            box-shadow: 10px 10px 30px rgba(223, 91, 91, 0.4), -5px -5px 15px rgba(255,255,255,0.5); 
            text-align: center; 
            min-width: 320px; 
            border: none;
        }

        .neo-session-alert h5 {
            margin-top: 0; 
            font-weight: 800; 
            color: #ffffff; 
            margin-bottom: 0.8rem;
            letter-spacing: 0.5px;
        }

        .neo-session-btn {
            background-color: #e8f0f6; 
            color: #df5b5b;
            border: none;
            border-radius: 50px;
            font-weight: bold;
            padding: 0.6rem 2rem;
            margin-top: 0.8rem;
            box-shadow: 0px 0px 25px 5px rgba(255, 255, 255, 0.85);
            transition: all 0.2s ease;
        }

        .neo-session-btn:hover {
            transform: scale(0.95);
            box-shadow: 0px 0px 15px 2px rgba(255, 255, 255, 0.9);
        }
    </style>
</head>
<body>
    <form runat="server">
        <asp:ScriptManager runat="server">
            <Scripts>
                <asp:ScriptReference Name="MsAjaxBundle" />
                <asp:ScriptReference Name="jquery" />
                <asp:ScriptReference Name="WebForms.js" Assembly="System.Web" Path="~/Scripts/WebForms/WebForms.js" />
                <asp:ScriptReference Name="WebUIValidation.js" Assembly="System.Web" Path="~/Scripts/WebForms/WebUIValidation.js" />
                <asp:ScriptReference Name="MenuStandards.js" Assembly="System.Web" Path="~/Scripts/WebForms/MenuStandards.js" />
                <asp:ScriptReference Name="GridView.js" Assembly="System.Web" Path="~/Scripts/WebForms/GridView.js" />
                <asp:ScriptReference Name="DetailsView.js" Assembly="System.Web" Path="~/Scripts/WebForms/DetailsView.js" />
                <asp:ScriptReference Name="TreeView.js" Assembly="System.Web" Path="~/Scripts/WebForms/TreeView.js" />
                <asp:ScriptReference Name="WebParts.js" Assembly="System.Web" Path="~/Scripts/WebForms/WebParts.js" />
                <asp:ScriptReference Name="Focus.js" Assembly="System.Web" Path="~/Scripts/WebForms/Focus.js" />
                <asp:ScriptReference Name="WebFormsBundle" />
            </Scripts>
        </asp:ScriptManager>

        <nav class="navbar navbar-expand-lg navbar-toggleable-lg navbar-light neo-navbar">
            <div class="container">
                
                <a class="navbar-brand d-flex flex-column align-items-center" runat="server" href="~/">
                    <span>James Carl Ibana</span>
                    <span style="font-size: 0.75rem; color: #5c7465; font-weight: 700;">WEB APPLICATION</span>
                </a>
                
                <!-- Mobile Toggler -->
                <button type="button" class="navbar-toggler" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" title="Toggle navigation" aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse">

                    <!-- Left Navigation Group -->
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0 align-items-center">
                        <li class="nav-item"><a class="nav-link" runat="server" href="~/Home">Home</a></li>
                        <li class="nav-item"><a class="nav-link" runat="server" href="~/About">About</a></li>
                        <li class="nav-item"><a class="nav-link" runat="server" href="~/Contact">Contact</a></li>

                        <li class="nav-item ms-lg-4"><a class="nav-link" runat="server" href="~/CollegeCRUD">College</a></li>
                        <li class="nav-item"><a class="nav-link" runat="server" href="~/ProgramCRUD">Program</a></li>
                        <li class="nav-item"><a class="nav-link" runat="server" href="~/StudentInfoCRUD">Student Info</a></li>
                    </ul>

                    <!-- Right Navigation Group -->
                    <ul class="navbar-nav ms-auto mb-2 mb-lg-0 align-items-center">
                        <li class="nav-item" id="navLogin" runat="server">
                            <a class="nav-link" runat="server" href="~/MyLogIn">Log In</a>
                        </li>
                        <li class="nav-item" id="navRegister" runat="server">
                            <a class="nav-link" runat="server" href="~/Register">Register</a>
                        </li>

                        <li class="nav-item" id="navWelcome" runat="server" visible="false">
                            <span class="nav-link neo-welcome-text d-flex flex-column align-items-center" style="line-height: 1.1;">
                                <span style="font-size: 0.75rem; color: #5c7465; font-weight: 700; text-transform: uppercase;">Welcome,</span>
                                <span style="color: #1a3324; font-weight: 800;"><asp:Label ID="lblUserName" runat="server"></asp:Label></span>
                            </span>
                        </li>
                        <li class="nav-item" id="navLogout" runat="server" visible="false">
                            <asp:LinkButton ID="btnLogOut" runat="server" CssClass="nav-link" OnClientClick="return confirm('Are you sure you want to log out?');" OnClick="btnLogOut_Click">Log Out</asp:LinkButton>
                        </li>
                    </ul>

                </div>

            </div>
        </nav>
        
        <!-- Main Content -->
        <div class="container body-content">
            <asp:ContentPlaceHolder ID="MainContent" runat="server">
            </asp:ContentPlaceHolder>
            <hr style="border-top: 2px solid #c2d0c8; box-shadow: 0 1px 1px #ffffff;" />
            <footer style="color: #5c7465; font-weight: 500;">
                <p>&copy; <%: DateTime.Now.Year %> - James Carl Ibana</p>
            </footer>
        </div>
    </form>
    
    <asp:PlaceHolder runat="server">
        <%: Scripts.Render("~/Scripts/bootstrap.js") %>
    </asp:PlaceHolder>

    <!-- Active Page Script -->
    <script type="text/javascript">
        document.addEventListener("DOMContentLoaded", function () {
            var currentPath = window.location.pathname.toLowerCase();
            
            if (currentPath === "/" || currentPath.endsWith("/default.aspx")) {
                currentPath = "/home";
            }

            var navLinks = document.querySelectorAll('.neo-navbar .nav-link');
            
            navLinks.forEach(function(link) {
                if (link.id && link.id.includes("btnLogOut")) return;
                if (link.classList.contains("neo-welcome-text")) return;

                var linkPath = link.pathname ? link.pathname.toLowerCase() : "";
                
                if (linkPath && currentPath.includes(linkPath)) {
                    link.classList.add('active-nav-link');
                }
            });
        });
    </script>

    <!-- Session Warning Output -->
    <asp:PlaceHolder ID="phSessionTimer" runat="server" Visible="false">
        
        <div id="sessionWarningBox" class="neo-session-alert">
            <h5>Session Expiring!</h5>
            <p>Your session will expire in <strong id="timeLeft" style="font-size: 1.2em;">15</strong> seconds due to inactivity.</p>
            <button type="button" onclick="extendSession()" class="neo-session-btn">Stay Logged In</button>
        </div>

        <script type="text/javascript">
            let sessionLength = 120;
            let warningTime = 15;
            let timeRemaining = sessionLength;
            let timerInterval;

            function startSessionTimer() {
                timeRemaining = sessionLength;
                document.getElementById('sessionWarningBox').style.display = 'none';
                clearInterval(timerInterval);

                timerInterval = setInterval(function () {
                    timeRemaining--;

                    if (timeRemaining <= warningTime && timeRemaining > 0) {
                        document.getElementById('sessionWarningBox').style.display = 'block';
                        document.getElementById('timeLeft').innerText = timeRemaining;
                    }
                    else if (timeRemaining <= 0) {
                        window.location.href = "MyLogIn.aspx";
                    }
                }, 1000);
            }

            function extendSession() {
                fetch(window.location.href);
                startSessionTimer();
            }

            window.onload = startSessionTimer;
        </script>
    </asp:PlaceHolder>
</body>
</html>